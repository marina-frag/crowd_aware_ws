Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 40; 40; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: i-WALK
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/MarkerArray
      Name: DWAL paths
      Enabled: true
      Topic:
        Value: /dwal_planner/sampled_pathMarkers
    - Class: rviz_default_plugins/MarkerArray
      Name: Near clusters
      Enabled: true
      Topic:
        Value: /dwal_planner/cluster_markers_near
    - Class: rviz_default_plugins/MarkerArray
      Name: Far clusters
      Enabled: true
      Topic:
        Value: /dwal_planner/cluster_markers_far
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Pitch: 1.1
      Yaw: 0.5
      Focal Point: {X: 0.5, Y: 0, Z: 0}
Window Geometry:
  Width: 1200
  Height: 800
