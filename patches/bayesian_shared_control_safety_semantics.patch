+
+bool SharedController::inputsFresh(const rclcpp::Time& now, std::string& reason) const
+{
+  const auto age = [&now](const rclcpp::Time& stamp) {
+    const double value = stamp.nanoseconds() == 0 ?
+      std::numeric_limits<double>::infinity() : (now - stamp).seconds();
+    return value < 0.0 ? std::numeric_limits<double>::infinity() : value;
+  };
+  if (age(last_odom_time_) > odom_timeout_) { reason = "stale odometry"; return false; }
+  if (age(last_user_time_) > reference_timeout_) { reason = "stale reference command"; return false; }
+  if (age(last_near_time_) > cluster_timeout_ && age(last_far_time_) > cluster_timeout_) {
+    reason = "stale DWAL clusters"; return false;
+  }
+  if (semantic_mode_ && age(last_tracks_time_) > tracks_timeout_) {
+    reason = "stale structured tracks"; return false;
+  }
+  return true;
+}
+
+void SharedController::publishBrakingRequirement()
+{
+  if (!variable_length_ || !braking_pub_) return;
+  const auto now = this->now();
+  const double age = (now-last_odom_time_).seconds();
+  const double source_age = now.seconds()-last_odom_source_stamp_;
+  double required = std::numeric_limits<double>::infinity();
+  if (has_odom_ && age >= 0 && age <= odom_timeout_ &&
+      source_age >= -0.1 && source_age <= odom_timeout_) {
+    const double speed = std::abs(last_robot_vel_.linear.x);
+    required = speed*reaction_time_ + speed*speed/(2.0*a_brake_) + stop_margin_;
+  }
+  std_msgs::msg::Float64MultiArray msg;
+  // Contract: [required length (m), odom timeout (s), odom source stamp (s)].
+  // Invalid/stale odometry sends infinity; clustering then rejects all paths.
+  msg.data = {required, odom_timeout_, last_odom_source_stamp_};
+  braking_pub_->publish(msg);
+}
+
+void SharedController::watchdogCallback()
+{
+  publishBrakingRequirement();
+  updateCommand();
+}
+
+double SharedController::candidateSpeed(const dwal_planner::msg::Path& path, double requested) const
+{
+  if (!std::isfinite(requested) || requested <= 0 || !std::isfinite(path.curvature) ||
+      !std::isfinite(path.available_length) || path.available_length <= stop_margin_) return 0.0;
+  // Solve v*T + v^2/(2*a) <= available_length - margin.
+  // The upstream path becomes a tangent after a 90-degree arc. Require
+  // the complete constant-curvature braking motion to fit before that join.
+  double room = path.available_length-stop_margin_;
+  if (std::fabs(path.curvature)>1.e-9)
+    room=std::min(room,M_PI_2/std::fabs(path.curvature));
+  const double cap = std::sqrt(a_brake_*a_brake_*reaction_time_*reaction_time_+2*a_brake_*room)
+                     - a_brake_*reaction_time_;
+  const double measured = std::fabs(last_robot_vel_.linear.x);
+  if (!std::isfinite(measured) || measured > cap+1.e-6) return 0.0;
+  double speed = std::min({requested, max_linear_, cap});
+  if (std::fabs(path.curvature)>1.e-9) speed=std::min(speed,max_angular_/std::fabs(path.curvature));
+  if (semantic_mode_) speed=std::min(speed,a_brake_*(prediction_horizon_-reaction_time_));
+  const double cost = std::clamp(static_cast<double>(path.cost)/c_max_,0.0,1.0);
+  return speed*std::max(s_min_,1.0-cost);
+}
+
+bool SharedController::humanStopSafe(const dwal_planner::msg::Path& path, double command_speed,
+                                    const std::vector<double>& pose0) const
+{
+  if (!semantic_mode_) return true;
+  if (pose0.size()<3 || footprint_.size()<3 ||
+      !std::isfinite(pose0[0]) || !std::isfinite(pose0[1]) || !std::isfinite(pose0[2]) ||
+      last_tracks_.header.frame_id != odom_frame_id_) return false;
+  const double speed=std::max(std::fabs(last_robot_vel_.linear.x),command_speed);
+  const double stop_time=reaction_time_+speed/a_brake_;
+  if (!std::isfinite(stop_time) || stop_time>prediction_horizon_+1.e-9) return false;
+  const double stamp=rclcpp::Time(last_tracks_.header.stamp).seconds();
+  double track_age=stamp>0 ? this->now().seconds()-stamp : (this->now()-last_tracks_time_).seconds();
+  if (track_age < -0.1 || track_age>tracks_timeout_) return false;
+  track_age=std::max(0.0,track_age); // Same clock skew tolerance; never extrapolate tracks backwards.
+  const int steps=std::max(1,static_cast<int>(std::ceil(stop_time/0.025)));
+  const double dt=stop_time/steps;
+  for (int j=0; j<=steps; ++j) {
+    const double t=dt*j, braking=std::max(0.0,t-reaction_time_);
+    const double distance=speed*t-0.5*a_brake_*braking*braking;
+    const double angle=path.curvature*distance, yaw=pose0[2]+angle;
+    const double x=pose0[0]+(std::fabs(path.curvature)<1.e-9 ? distance*std::cos(pose0[2]) :
+      (std::sin(yaw)-std::sin(pose0[2]))/path.curvature);
+    const double y=pose0[1]+(std::fabs(path.curvature)<1.e-9 ? distance*std::sin(pose0[2]) :
+      (std::cos(pose0[2])-std::cos(yaw))/path.curvature);
+    for (const auto& agent : last_tracks_.agents) {
+      if (agent.type != cohan_msgs::msg::AgentType::HUMAN) continue;
+      const cohan_msgs::msg::TrackedSegment* torso=nullptr;
+      for (const auto& segment : agent.segments)
+        if (segment.type==cohan_msgs::msg::TrackedSegmentType::TORSO) {torso=&segment;break;}
+      if (!torso) return false;
+      const double vx=torso->twist.twist.linear.x, vy=torso->twist.twist.linear.y;
+      const double hx=torso->pose.pose.position.x+vx*(track_age+t)-x;
+      const double hy=torso->pose.pose.position.y+vy*(track_age+t)-y;
+      if (!std::isfinite(hx)||!std::isfinite(hy)||!std::isfinite(vx)||!std::isfinite(vy)) return false;
+      const double px=std::cos(yaw)*hx+std::sin(yaw)*hy;
+      const double py=-std::sin(yaw)*hx+std::cos(yaw)*hy;
+      double closest=std::numeric_limits<double>::infinity();
+      bool inside=false;
+      for (size_t k=0,l=footprint_.size()-1;k<footprint_.size();l=k++) {
+        const auto [ax,ay]=footprint_[l]; const auto [bx,by]=footprint_[k];
+        if ((ay>py)!=(by>py) && px < (bx-ax)*(py-ay)/(by-ay)+ax) inside=!inside;
+        const double dx=bx-ax,dy=by-ay,norm=dx*dx+dy*dy;
+        const double u=norm>0 ? std::clamp(((px-ax)*dx+(py-ay)*dy)/norm,0.0,1.0) : 0.0;
+        closest=std::min(closest,std::hypot(px-ax-u*dx,py-ay-u*dy));
+      }
+      // Bound travel between temporal samples, including footprint rotation.
+      const double margin=human_radius_+human_uncertainty_+human_growth_*t+
+        dt*(std::hypot(vx,vy)+speed*(1+footprint_radius_*std::fabs(path.curvature)));
+      if (inside || closest<=margin) return false;
+    }
+  }
+  return true;
+}
+
+double SharedController::socialCost(
+  double phi, double radius, double speed, const std::array<double, 3>& pose0) const
+{
+  if (!semantic_mode_ || last_tracks_.agents.empty()) return 0.0;
+  double margin_scale = 1.0;
+  if (context_profile_ == "DENSE_CROWD") margin_scale = 1.35;
+  else if (context_profile_ == "DOORWAY" || context_profile_ == "OCCLUSION") margin_scale = 1.2;
+  const double sigma = std::max(0.1, personal_space_ * margin_scale);
+  const double curvature = cluster_lib::phi2curv(phi, radius);
+  nav_msgs::msg::Path candidate;
+  cluster_lib::generatePath(candidate, curvature, pose0[0], pose0[1], pose0[2],
+                            0.1, radius * radius, odom_frame_id_);
+  double closest = std::numeric_limits<double>::infinity();
+  const double safe_speed = std::max(std::fabs(speed), 0.05);
+  for (size_t i = 0; i < candidate.poses.size(); ++i) {
+    const double t = (0.1 * static_cast<double>(i)) / safe_speed;
+    if (t > prediction_horizon_) break;
+    const auto& point = candidate.poses[i].pose.position;
+    for (const auto& agent : last_tracks_.agents) {
+      for (const auto& segment : agent.segments) {
+        if (segment.type != cohan_msgs::msg::TrackedSegmentType::TORSO) continue;
+        const double px = segment.pose.pose.position.x + segment.twist.twist.linear.x * t;
+        const double py = segment.pose.pose.position.y + segment.twist.twist.linear.y * t;
+        closest = std::min(closest, std::hypot(point.x - px, point.y - py));
+      }
+    }
+  }
+  return std::isfinite(closest) ? std::exp(-0.5 * closest * closest / (sigma * sigma)) : 0.0;
 }
 
