+
+bool SharedController::inputsFresh(const rclcpp::Time& now, std::string& reason) const
+{
+  const auto age = [&now](const rclcpp::Time& stamp) {
+    const double value = stamp.nanoseconds() == 0 ?
+      std::numeric_limits<double>::infinity() : (now - stamp).seconds();
+    return value < 0.0 ? std::numeric_limits<double>::infinity() : value;
+  };
+  if (age(last_odom_time_) > odom_timeout_) { reason = "stale odometry"; return false; }
+  if (age(last_user_time_) > reference_timeout_) { reason = "stale reference command"; return false; }
+  if (age(last_near_time_) > cluster_timeout_ && age(last_far_time_) > cluster_timeout_) {
+    reason = "stale DWAL clusters"; return false;
+  }
+  if (semantic_mode_ && age(last_tracks_time_) > tracks_timeout_) {
+    reason = "stale structured tracks"; return false;
+  }
+  return true;
+}
+
+void SharedController::watchdogCallback()
+{
+  std::string reason;
+  if (!inputsFresh(this->now(), reason)) {
+    publishCmd(MakeZeroTwist());
+    RCLCPP_WARN_THROTTLE(get_logger(), *get_clock(), 2000, "%s: controlled stop", reason.c_str());
+  }
+}
+
+double SharedController::socialCost(
+  double phi, double radius, double speed, const std::array<double, 3>& pose0) const
+{
+  if (!semantic_mode_ || last_tracks_.agents.empty()) return 0.0;
+  double margin_scale = 1.0;
+  if (context_profile_ == "DENSE_CROWD") margin_scale = 1.35;
+  else if (context_profile_ == "DOORWAY" || context_profile_ == "OCCLUSION") margin_scale = 1.2;
+  const double sigma = std::max(0.1, personal_space_ * margin_scale);
+  const double curvature = cluster_lib::phi2curv(phi, radius);
+  nav_msgs::msg::Path candidate;
+  cluster_lib::generatePath(candidate, curvature, pose0[0], pose0[1], pose0[2],
+                            0.1, radius * radius, odom_frame_id_);
+  double closest = std::numeric_limits<double>::infinity();
+  const double safe_speed = std::max(std::fabs(speed), 0.05);
+  for (size_t i = 0; i < candidate.poses.size(); ++i) {
+    const double t = (0.1 * static_cast<double>(i)) / safe_speed;
+    const auto& point = candidate.poses[i].pose.position;
+    for (const auto& agent : last_tracks_.agents) {
+      for (const auto& segment : agent.segments) {
+        if (segment.type != cohan_msgs::msg::TrackedSegmentType::TORSO) continue;
+        const double px = segment.pose.pose.position.x + segment.twist.twist.linear.x * t;
+        const double py = segment.pose.pose.position.y + segment.twist.twist.linear.y * t;
+        closest = std::min(closest, std::hypot(point.x - px, point.y - py));
+      }
+    }
+  }
+  return std::isfinite(closest) ? std::exp(-0.5 * closest * closest / (sigma * sigma)) : 0.0;
 }
 
