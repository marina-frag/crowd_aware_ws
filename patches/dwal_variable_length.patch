+// Fixed DWAL keeps the upstream geometry verbatim; the variable-length
+// geometry corrections apply only when variable_length is enabled.
+int SimpleTrajectoryGenerator::generateTrajectory(double sample_curv, dwal_planner::msg::SampledPath &traj,
+                                                  costmap_2d::Costmap2DROS *costmap)
+{
+  return variable_length ? generateTrajectoryVariable(sample_curv, traj, costmap)
+                         : generateTrajectoryUpstream(sample_curv, traj, costmap);
+}
+
 int SimpleTrajectoryGenerator::generateTrajectoryWithFootprint(double sample_curv, dwal_planner::msg::SampledPath &traj,
                                                    costmap_2d::Costmap2DROS *costmap,
                                                    base_local_planner::CostmapModel *cmap_model)
+{
+  return variable_length ? generateTrajectoryWithFootprintVariable(sample_curv, traj, costmap, cmap_model)
+                         : generateTrajectoryWithFootprintUpstream(sample_curv, traj, costmap, cmap_model);
+}
