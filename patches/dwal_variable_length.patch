   void findCorrespondence()
+  {
+    if (correspondence_mode == "tracking") { trackCorrespondence(); return; }
+    corresp_matrix.clear();
+    if (cluster_num == 0) //current frame empty
+    {
+      prev_ids.clear();
+      prev_mean_phi.clear();
+      prev_cluster_num = cluster_num;
+      return;
+    }
+
+    if (prev_cluster_num == 0) //previous frame empty
+    {
+      prev_ids.clear();
+      prev_mean_phi.clear();
+      prev_cluster_num = cluster_num;
+      unsigned int i = 0;
+      for (auto &cl : group.clusters)
+      {
+        cl.id = static_cast<int>(i);
+        prev_mean_phi.push_back((cluster_lib::curv2phi(cl.paths.front().curvature, levels[level_index]) + cluster_lib::curv2phi(cl.paths.back().curvature, levels[level_index])) / 2);
+        prev_ids.push_back(i);
+        i++;
+      }
+      return;
+    }
+
+    cur_mean_phi.clear();
+    phi_distances.clear();
+    temp.clear();
+
+    //calculate mean phis for current clusters
+    for (auto &cl : group.clusters)
+      cur_mean_phi.push_back((cluster_lib::curv2phi(cl.paths.front().curvature, levels[level_index]) + cluster_lib::curv2phi(cl.paths.back().curvature, levels[level_index])) / 2);
+
+    temp.resize(static_cast<size_t>(cluster_num)); //calculate mean phi distance between clusters
+    for (int k = 0; k < prev_cluster_num; k++)
+    {
+      phi_distances.push_back(temp);
+      for (int i = 0; i < cluster_num; i++)
+        phi_distances[static_cast<size_t>(k)][static_cast<size_t>(i)] = std::fabs(cur_mean_phi[static_cast<size_t>(i)] - prev_mean_phi[static_cast<size_t>(k)]);
+    }
+
+    int row, col; //find minimum phi distance
+    double minimum;
+    for (int j = 0; j < std::min(prev_cluster_num, cluster_num); j++)
+    {
+      row = col = 0;
+      minimum = 1000;
+      for (int k = 0; k < prev_cluster_num; k++)
+      {
+        for (int i = 0; i < cluster_num; i++)
+        {
+          if (phi_distances[static_cast<size_t>(k)][static_cast<size_t>(i)] < minimum)
+          {
+            minimum = phi_distances[static_cast<size_t>(k)][static_cast<size_t>(i)];
+            row = k;
+            col = i;
+          }
+        }
+      }
+      group.clusters[static_cast<size_t>(col)].id = static_cast<int>(prev_ids[static_cast<size_t>(row)]); //assign same id to min distance
+      corresp_matrix[prev_ids[static_cast<size_t>(row)]] = static_cast<unsigned int>(col); // prev ID -> current INDEX
+
+      //invalidate selected row and col by assigning distance=1000
+      for (int k = 0; k < prev_cluster_num; k++)
+        phi_distances[static_cast<size_t>(k)][static_cast<size_t>(col)] = 1000;
+      std::fill(phi_distances[static_cast<size_t>(row)].begin(), phi_distances[static_cast<size_t>(row)].end(), 1000);
+    }
+
+    if (cluster_num > prev_cluster_num)
+    {
+      unsigned int j = 0; //for the rest of the clusters assign appropriate id
+      std::vector<unsigned int>::iterator it;
+      it = std::find(prev_ids.begin(), prev_ids.end(), j);
+      for (auto &cl : group.clusters)
+      {
+        j = 0;
+        it = std::find(prev_ids.begin(), prev_ids.end(), j);
+        if (cl.id == 100)
+        {
+          while (it != prev_ids.end())
+          {
+            j++;
+            it = std::find(prev_ids.begin(), prev_ids.end(), j);
+          }
+          cl.id = static_cast<int>(j);
+          prev_ids.push_back(j);
+        }
+      }
+    }
+    prev_ids.clear();
+    prev_mean_phi.clear();
+    prev_cluster_num = cluster_num;
+    prev_mean_phi = cur_mean_phi;
+    for (int i = 0; i < cluster_num; i++)
+      prev_ids.push_back(static_cast<unsigned int>(group.clusters[static_cast<size_t>(i)].id));
+  }
+
+  void doClustering(const dwal_planner::msg::SampledCluster::SharedPtr msg, double required_length)
+  {
+    if (!variable_length) { doClusteringUpstream(msg); return; }
+    //msg contains all sampled paths, for the given level, up to their collision point (if one exists)
+    cluster_num = 0;
+    Rcl = levels[static_cast<size_t>(level_index)];
+    path_num = static_cast<int>(msg->paths.size());
+    diagnostic_codes.assign(msg->paths.size(), -1);
+    diagnostic_required = required_length;
+    current_yaw_ = msg->pose0.size() >= 3 ? msg->pose0[2] : std::numeric_limits<double>::quiet_NaN();
+    free_path_indexes.clear();
+    sliced_path_indexes.clear();
+    cluster_indexes.clear();
+    cluster_vecs.clear();
+    group.clusters.clear();
+    while (marker_num < path_num) {
+      path_marker.id = marker_num++;
+      path_array_marker.markers.push_back(path_marker);
+    }
+    for (int k = 0; k < marker_num; k++)
+      path_array_marker.markers[static_cast<size_t>(k)].points.clear(); //clear all path markers
+
+    // Reuse the generator's checked free geometry; no second collision model.
+    std::vector<double> available_lengths(msg->paths.size(), 0.0);
+    for (size_t k = 0; k < msg->paths.size(); ++k) {
+      const auto& poses = msg->paths[k].poses;
+      for (size_t j = 1; j < poses.size(); ++j) {
+        const double segment = std::hypot(poses[j].x - poses[j-1].x,
+                                          poses[j].y - poses[j-1].y);
+        if (!std::isfinite(segment)) {
+          available_lengths[k] = std::numeric_limits<double>::quiet_NaN();
+          break;
+        }
+        available_lengths[k] += segment;
+      }
+    }
+    // DWA admissibility (Fox et al. 1997): the robot must stop within the free
+    // length. Braking is modelled at constant curvature, and the arc-line path
+    // turns into a tangent after 90 degrees, so the usable length is also capped
+    // at stop_margin + (pi/2)/|k|. This is the only admissibility check; the
+    // shared controller only derives the speed from the same model.
+    const auto usable_length = [&](size_t k) {
+      const double curvature = std::fabs(msg->paths[k].curvature);
+      return curvature > 1.e-9 ? std::min(available_lengths[k], braking_margin + M_PI_2 / curvature)
+                               : available_lengths[k];
+    };
+    size_t rejected_braking = 0;
+    for (int k = 0; k < path_num; k++)
+    { //get free paths
+      const auto& path = msg->paths[static_cast<size_t>(k)];
+      if (path.poses.size() >= 2 && std::isfinite(path.curvature) &&
+          (variable_length ?
+           (std::isfinite(required_length) && std::isfinite(available_lengths[k]) &&
+            usable_length(static_cast<size_t>(k)) >= required_length) :
+           (path.colission_r > Rcl && path.level_inds.size() > static_cast<size_t>(level_index))))
+      {
+        free_path_indexes.push_back(k);
+        diagnostic_codes[static_cast<size_t>(k)] = -4;
+      }
+      else if (variable_length) {
+        ++rejected_braking;
+        if (path.poses.size() >= 2 && std::isfinite(path.curvature) &&
+            std::isfinite(available_lengths[k])) diagnostic_codes[static_cast<size_t>(k)] = -2;
+      }
+    }
+    if (variable_length) RCLCPP_INFO_THROTTLE(node_->get_logger(), *node_->get_clock(), 2000,
+      "DWAL braking: required_length=%.3f accepted=%zu rejected=%zu",
+      required_length, free_path_indexes.size(), rejected_braking);
+
+    if (free_path_indexes.empty() || msg->pose0.size() < 3)
+    {
+      findCorrespondence();
+      RCLCPP_WARN_THROTTLE(node_->get_logger(), *node_->get_clock(), 2000,
+        "DWAL clustering: samples=%d free_prefixes=%zu groups=0 (empty/invalid geometry)",
+        path_num, free_path_indexes.size());
+      group_publisher->publish(group); //publish empty clusters
+      publishMarkers(); //publish empty markers and exit
+      return;
+    }
+
+    // do cluster slicing with source group, if flag is raised
+    //////--- start slicing -----------------------------------------------------------
+    if (do_slice)
+    {
+      source_slice_cluster_index = source_slice_group_ptr ?
+        clusterIdtoIndex(source_slice_cluster_id, source_slice_group_ptr) : -1;
+      if (source_slice_cluster_index < 0 ||
+          source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index)].paths.empty())
+      {
+        // Do not publish an unsliced fallback or leave last frame's result alive.
+        // group and marker points were cleared at the beginning of this cycle.
+        source_slice_cluster_index = -1;
+        findCorrespondence();
+        group_publisher->publish(group);
+        publishMarkers();
+        RCLCPP_INFO_THROTTLE(node_->get_logger(), *node_->get_clock(), 2000,
+          "Slice source ID %d unavailable; publishing empty target", source_slice_cluster_id);
+        return;
+      }
+      switch (direction)
+      {
+        case false: //false = right
+          max_curv_slice = source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index)].paths.back().curvature;
+          if (source_slice_cluster_index > 0 &&
+              !source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index - 1)].paths.empty())
+            min_curv_slice = source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index - 1)].paths.back().curvature;
+          else
+            min_curv_slice = msg->paths.front().curvature;
+          break;
+
+        case true: //true = left
+          min_curv_slice = source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index)].paths[0].curvature;
+          if (source_slice_cluster_index < static_cast<int>(source_slice_group_ptr->clusters.size()) - 1 &&
+              !source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index + 1)].paths.empty())
+            max_curv_slice = source_slice_group_ptr->clusters[static_cast<size_t>(source_slice_cluster_index + 1)].paths[0].curvature;
+          else
+            max_curv_slice = msg->paths.back().curvature;
+          break;
+      }
+
+      for (int &k : free_path_indexes)
+        if (msg->paths[static_cast<size_t>(k)].curvature >= min_curv_slice &&
+            msg->paths[static_cast<size_t>(k)].curvature <= max_curv_slice)
