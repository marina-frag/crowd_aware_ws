+      }
+      tmp_cluster.pose0 = msg->pose0;
+
+      for (int &l : clvec)
+      {
+        if (*spin != 0)
+        {
+          const auto & path = msg->paths[static_cast<size_t>(l)];
+          const int last = std::min(
+            static_cast<int>(path.poses.size()) - 1,
+            variable_length ? static_cast<int>(path.poses.size())-1 : path.level_inds[static_cast<size_t>(level_index)]);
+
+          for (int j = 0; j <= last; j += subsample_step)
+          {
+            p0.x = path.poses[static_cast<size_t>(j)].x;
+            p0.y = path.poses[static_cast<size_t>(j)].y;
+            path_array_marker.markers[static_cast<size_t>(l)].points.push_back(p0);
+          }
+          if (last >= 0 && (last % subsample_step) != 0)
+          {
+            p0.x = path.poses[static_cast<size_t>(last)].x;
+            p0.y = path.poses[static_cast<size_t>(last)].y;
+            path_array_marker.markers[static_cast<size_t>(l)].points.push_back(p0);
+          }
+        }
+        tmp_path.curvature = msg->paths[static_cast<size_t>(l)].curvature;
+        const auto& path = msg->paths[static_cast<size_t>(l)];
+        tmp_path.phi = cluster_lib::curv2phi(path.curvature, tmp_cluster.r);
+        tmp_path.cost = path.costs.empty() ? 0 : path.costs[variable_length ? path.costs.size()-1 : level_index];
+        tmp_path.available_length = available_lengths[static_cast<size_t>(l)];
+        tmp_path.available_radius = std::hypot(path.poses.back().x-msg->pose0[0], path.poses.back().y-msg->pose0[1]);
+        tmp_cluster.paths.push_back(tmp_path); //add path to current cluster
+      }
+      group.clusters.push_back(tmp_cluster);
+    }
+
+    RCLCPP_INFO_THROTTLE(node_->get_logger(), *node_->get_clock(), 2000,
+      "DWAL clustering: samples=%d free_prefixes=%zu clusters=%d separation=%d min_span=%.3f width_reference=%.3f level=%.3f",
+      path_num, free_path_indexes.size(), cluster_num, cluster_separation, min_cluster_span, levels.back(), Rcl);
