+      cluster_indexes.push_back(index);
+    }
+    finish();
+
+    cluster_num = static_cast<int>(cluster_vecs.size());
+    //////--- end clustering -----------------------------------------------------------
+
+    //populate cluster_group msg and path markers
+    //int j;
+    for (std::vector<int> &clvec : cluster_vecs)
